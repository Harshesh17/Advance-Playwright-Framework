{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://thetestingacademy.com/schemas/auth.schema.json",
    "title": "AuthTokenResponse",
    "description": "Response shape from POST https://restful-booker.herokuapp.com/auth on success.",
    "type": "object",
    "required": ["token"],
    "additionalProperties": false,
    "properties": {
        "token": {
            "type": "string",
            "minLength": 8,
            "pattern": "^[A-Za-z0-9]+$"
        }
    }
}

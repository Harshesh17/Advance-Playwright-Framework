# =============================================================================
# API Testing Framework - Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# The .env file is git-ignored and should NEVER be committed.

# -----------------------------------------------------------------------------
# Restful Booker (primary - free, public, no signup needed)
# Docs: https://restful-booker.herokuapp.com/apidoc/index.html
# -----------------------------------------------------------------------------
BOOKER_URL=https://restful-booker.herokuapp.com
BOOKER_USER=admin
BOOKER_PASS=password123

# -----------------------------------------------------------------------------
# Spotify Web API (OAuth2 client_credentials demo)
# Register an app at: https://developer.spotify.com/dashboard
# Then drop your Client ID and Client Secret here. The framework uses the
# client_credentials grant only - it never touches user data or PII.
# -----------------------------------------------------------------------------
SPOTIFY_API_URL=https://api.spotify.com
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# -----------------------------------------------------------------------------
# Test runtime knobs
# -----------------------------------------------------------------------------
API_RESPONSE_TIME_BUDGET_MS=3000
NODE_ENV=test

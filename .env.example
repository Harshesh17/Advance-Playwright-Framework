# Copy this file to .env.dev / .env.staging / .env.prod (or just .env)
# The env-loader picks .env.${NODE_ENV} first, then falls back to .env.

# Default (dev)
BASE_URL=https://app.thetestingacademy.com/playwright/ttacart/index.html

# Staging override example
DEV_BASE_URL=https://app.thetestingacademy.com/playwright/ttacart/index.html
STAGING_BASE_URL=https://staging.thetestingacademy.com/playwright/ttacart/index.html
PROD_BASE_URL=https://app.thetestingacademy.com/playwright/ttacart/index.html

# Default test users (match TTACart source)
STANDARD_USER=standard_user
LOCKED_USER=locked_out_user
PROBLEM_USER=problem_user
GLITCH_USER=performance_glitch_user
ERROR_USER=error_user
VISUAL_USER=visual_user
TTA_PASSWORD=tta_secret

# Browser controls
HEADED=false
SLOW_MO=0

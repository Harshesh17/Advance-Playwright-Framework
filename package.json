{
  "name": "cucumber-bdd-pom",
  "version": "1.0.0",
  "description": "Cucumber BDD + Playwright + Page Object Model framework targeting TTACart by The Testing Academy",
  "private": true,
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "test:wip": "cucumber-js --tags @wip",
    "test:dev": "NODE_ENV=dev cucumber-js",
    "test:staging": "NODE_ENV=staging cucumber-js",
    "test:prod": "NODE_ENV=prod cucumber-js",
    "report": "node scripts/generate-html-report.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install --with-deps chromium || playwright install chromium"
  },
  "keywords": [
    "cucumber",
    "bdd",
    "playwright",
    "typescript",
    "pom",
    "ttacart",
    "the-testing-academy"
  ],
  "author": "The Testing Academy",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
